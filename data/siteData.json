  "guests": [
    {
      "id": "153",
      "name": "bạn Vĩ Khang",
      "secretLetter": "Cảm ơn Khang khoảng thời gian đi cùng Trí những ngày đầu bước vào con đường tư bản hehe, tui vẫn luôn nhớ những ngày đó, không có quên âu.",
      "customLetterImage": "",
      "note": "",
      "createdAt": "2026-11-12T09:57:14.263Z"
    },
    {
      "id": "151",
      "name": "bạn Thúy Ngân",
      "secretLetter": "Tui xin phép bộc bạch thầm kín với bà ở đây nha. Tui cảm ơn bà luôn quan tâm, để ý tới tui từ năm nhất tới giờ. Trải qua 4 năm rồi, tui cũng vui khi mình còn chơi với nhau, còn cơ hội để tui viết những câu này. Mặc dù có những lúc tui buồn, tui sợ k còn chơi với bà được, nhưng qua những lúc đó, tui thấy tui cần phải thay đổi, cần phải nghiêm túc hơn, dần dần tui sống tốt lên cũng nhờ bà. Tui mến bà, hạnh phúc khi gặp được bà ở chặng đường đại học",
      "customLetterImage": "https://raw.githubusercontent.com/TriNguyen2808/thiep-tot-nghiep/main/public/uploads/1794474736172_vf1f3_IMG_7916.jpg",
      "note": "",
      "createdAt": "2026-11-12T09:06:35.678Z"
    },
